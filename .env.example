# Groq (free) — get key at console.groq.com
GROQ_API_KEY=gsk_your_free_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding model
EMBED_MODEL=all-MiniLM-L6-v2

# Vision model path
ONNX_MODEL_PATH=backend/models/crop_disease.onnx

# App settings
DEBUG=true
PORT=8000

# Set to true to skip API calls and use demo data
DEMO_MODE=false